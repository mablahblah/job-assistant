{
  "name": "job-assistant-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cli": "npx tsx legacy/scripts/cli.ts",
    "serve": "npx tsx legacy/scripts/serve.ts",
    "postinstall": "npx prisma generate",
    "db:create": "npx tsx scripts/db-create.ts",
    "db:seed": "npx tsx scripts/db-seed.ts",
    "collect": "npx tsx scripts/collect.ts",
    "lint": "npx eslint . --ext .ts && npm run typecheck",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "apify-client": "^2.22.3",
    "dotenv": "^17.3.1",
    "hono": "^4.12.14",
    "linkedom": "^0.18.13",
    "playwright": "^1.58.2",
    "prisma": "^7.5.0",
    "stemmer": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "eslint": "^8.57.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
