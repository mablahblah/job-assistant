generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Company {
  id                   String    @id @default(cuid())
  name                 String    @unique
  employeeSatisfaction Int?      // 1–5
  customerSatisfaction Int?      // 1–5
  workLifeBalance      Int?      // 1–5
  politicalAlignment   Int?      // 1–5
  note                 String?   // brief scoring rationale from Claude
  // enrichment fields for TWC work search log (address/phone populated by Feature 2)
  address              String?
  phone                String?
  website              String?
  enrichedAt           DateTime? // null = not yet enriched; prevents redundant API calls
  enrichmentStatus     String?   // null = never triggered, "pending", "complete", "failed"
  enrichmentUncertain  Boolean   @default(false) // true if any heuristic flag tripped during enrichment
  enrichmentFlags      String?   // comma-separated reasons, e.g. "address_outside_us,name_mismatch"
  atsPlatform          String?   // "greenhouse", "lever", "ashby", etc.
  atsSlug              String?   // board slug, e.g. "gitlab", "plaid"
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  jobs                 Job[]
}

model Job {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  title       String
  url         String
  location    String      @default("")
  workMode    String      @default("remote") // in-person, hybrid, remote
  firstPublished  DateTime
  repostedAt      DateTime?
  salaryRange String
  status          String      @default("backlog") // backlog, too far, won't apply, app. sent, rejected, screening, interview, test, offer, expired
  locationFlagged Boolean     @default(false) // true when auto-set to "too far" because remote location didn't match inclusion/exclusion lists
  jobAlignment          Int?        // 1–5, alignment score evaluated by Claude against profile in job-alignment.md
  titleMismatch         Boolean     @default(false) // true when job title doesn't match the user's search intent
  titleMismatchReason   String?     // Claude's explanation of why title was flagged
  source          String?     // which collector found this job (e.g. "adzuna", "dribbble", "external")
  parser          String?     // which parser processed it (e.g. "ashby", "collector-only"), null if unparsed
  originalUrl     String?     // original collector URL (provenance — where the collector found this job)
  modifiedAt      DateTime?   // tracks when status was last changed (null = never changed)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workSearchEntries WorkSearchEntry[] // auto-created when status moves to app. sent/screening/interview

  @@unique([url])
  @@index([companyId])
  @@index([status])
}


// URLs of deleted jobs — scraper skips these so they don't reappear
model BlockedJob {
  id        String   @id @default(cuid())
  url       String   @unique
  createdAt DateTime @default(now())
}

model ScrapingRun {
  id          String    @id @default(cuid())
  source      String    // e.g. "adzuna", "greenhouse", "linkedin"
  status      String    @default("pending") // pending, running, completed, failed
  jobsFound   Int       @default(0)
  jobsNew     Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

// One row per qualifying status change — feeds the TWC weekly work search log
model WorkSearchEntry {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  date         DateTime // when the status change happened
  activityType String   // "Applied for job", "Had phone screen", "Had interview"
  result       String   @default("Application filed") // TWC result checkbox value
  createdAt    DateTime @default(now())

  @@index([jobId])
  @@index([date])
}

// Caches geocoded coordinates for location strings — one API call per unique string
model LocationCache {
  id             String   @id @default(cuid())
  locationString String   @unique // normalized post-prefilter string
  lat            Float
  lon            Float
  displayName    String   // full resolved name from geocoding
  createdAt      DateTime @default(now())
}

// Allow/block decisions for Nominatim response classes (e.g. "boundary" allowed, "amenity" blocked)
model GeocodingClassRule {
  id        String   @id @default(cuid())
  className String   @unique // Nominatim class value (e.g. "boundary", "amenity")
  action    String   // "allow" or "block"
  createdAt DateTime @default(now())
}
