// Schema for the new pipeline's database. It grows a phase at a time; the
// tables collection needs are added with the schema task.
generator client {
  provider = "prisma-client"
  output   = "../generated/pipeline"
}

datasource db {
  provider = "sqlite"
}

// A single job posting. Collection fills what its source supplied and leaves
// the rest empty, so a later phase can tell what still needs doing.
model Job {
  id                       String    @id @default(cuid())
  // Which company this job belongs to. Company association decides it and
  // save writes the column.
  company_id               String?
  // The employer as the collector spelled it. The normalized name lives on
  // the company record.
  raw_company_name         String?
  // The board slug an ATS collector polled. A stronger identity than a name,
  // and what company association looks up first.
  raw_company_slug         String?
  // The title as the source published it, kept exactly.
  raw_title                String?
  // The title reshaped into one wording, as "{level} {role} - {team}",
  // built from raw_title. Two sources publishing the same role produce the
  // same title here.
  title                    String?
  // The link the collector found, often an aggregator redirect.
  original_url             String?
  // original_url squashed down for matching: the scheme, the lowercased host,
  // and the path with any trailing slash dropped. The whole query string and
  // any fragment go, so a source minting a fresh token every request still
  // matches its own earlier link. The published link is never altered, since
  // stripping a query breaks it.
  original_url_match_key   String?
  // The source posting, found by following original_url.
  resolved_url             String?
  // resolved_url squashed down the same way.
  resolved_url_match_key   String?
  // When the source says the posting went live.
  posting_date             DateTime?
  // When the source says the posting last changed, where the source
  // distinguishes the two.
  posting_updated_date     DateTime?
  created_at               DateTime  @default(now())
  modified_at              DateTime  @updatedAt
  // Phase gates. Each phase sets its own once it has handled the job.
  is_resolved              Boolean   @default(false)
  is_parsed                Boolean   @default(false)
  is_classified            Boolean   @default(false)
  // Lifecycle state. The first seven are non-active. The last five are
  // what active means: the user has applied and has not been rejected,
  // and an active row stays frozen except for its status. All twelve, in
  // order: backlog, expired, too far, won't apply, unresolvable,
  // unparseable, rejected, app. sent, screening, interview, test, offer.
  status                   String    @default("backlog")
  // Every location collected, kept intact. Independent of the mode list,
  // not paired by position.
  raw_location_list        Json?
  // Every raw_location_list entry cut into single places, with the words that
  // surround a place rather than name one taken out. Normalization builds it,
  // and classification judges each place on its own. A piece naming nothing on
  // a map is kept, because a real place standing beside it still has to be
  // judged.
  normalized_location_list Json?
  // Every work mode collected, kept intact. Independent of the location
  // list, not paired by position.
  raw_mode_list            Json?
  // Every entry in raw_mode_list translated into one of remote, hybrid, or
  // in-person, each held once. A source word outside those three is dropped
  // rather than guessed at.
  normalized_mode_list     Json?
  // Which collector produced it.
  collector                String?
  // When this pipeline first saw the posting, written once by the
  // orchestrator beside collector. A later sighting is not better
  // information the way a later salary is, so nothing overwrites this
  // and no default could supply it.
  collected_at             DateTime
  // Which parser read the posting, beside collector, which records which
  // collector produced it. When two copies of a job contest a field, the
  // winning side's collector and parser are both written onto the row.
  parser                   String?
  // Salary as the source published it, in a fixed five-key envelope whose
  // values are untouched: salary_min, salary_max, salary_period,
  // salary_currency, salary_unit. Normalization reshapes them.
  raw_salary               Json?
  // The bottom of the published salary range, in whole currency units.
  salary_low               Int?
  // The top of the published salary range, in whole currency units.
  salary_high              Int?
  // What the salary figures are per: year, month, week, day, or hour.
  salary_period            String?
  // The posting's own words, as the source supplied them. Scoring reads this
  // rather than reopening the posting to fetch them again.
  description              String?
  // Whether any place and work mode pair put this job close enough to work.
  // Three states rather than two: empty means no place on the job could be
  // read at all, which is not the same answer as too far. A job sitting empty
  // is left in the backlog for a later run to retry.
  location_match           Boolean?
  // The place text behind the pair that matched, and the work mode it was
  // paired with. Where several pairs matched, the place whose centre is
  // nearest is the one recorded, so a job passing on both a nearby city and a
  // whole country shows the city.
  location_match_place     String?
  location_match_mode      String?
  // Whether the posting's two dates sit further apart than the repost gap
  // setting, which reads as the employer listing the role again rather than
  // as two collectors disagreeing by hours about one posting.
  is_repost                Boolean?
  company                  Company?  @relation(fields: [company_id], references: [id])

  // Dedupe's two link clauses look a match up on these keys, so each is
  // indexed rather than scanned. Neither is unique: two rows for one posting
  // hold the same key from the moment both are saved until the pass that
  // collapses them, and a merge the active guardrail refuses leaves that pair
  // standing for good.
  @@index([original_url_match_key])
  @@index([resolved_url_match_key])
  // Dedupe's third clause searches on company and title together, so one
  // combined index serves it rather than two the database would have to pick
  // between. company_id leads because it narrows hardest: a title is shared
  // across employers. Not unique, for the same reason the two above are not.
  @@index([company_id, title])
}

// An employer. A collector polls the companies carrying its ats_platform and
// an ats_slug, so the slug lists are these rows rather than a table of their own.
model Company {
  id           String   @id @default(cuid())
  // Optional, because a company met only as a board slug has no name yet and
  // nothing invents one for it.
  name         String?  @unique
  // The name squashed down for matching: lowercased, stripped of everything
  // that is not a letter or a digit, and shorn of trailing legal-entity
  // words. Unique, so the database refuses a duplicate employer whatever the
  // matching code does.
  match_key    String?  @unique
  // Which applicant tracking system the company posts on, where known.
  ats_platform String?
  // The company's board slug on that system, where known. Unique, because a
  // job carries a slug without carrying which board it came from, so a slug
  // held by two companies could not be resolved to one.
  ats_slug     String?  @unique
  created_at   DateTime @default(now())
  modified_at  DateTime @updatedAt
  jobs         Job[]
}

// Single-row configuration. A seed script fills whatever is absent and
// overwrites nothing; the settings service reads only and throws when a
// setting is missing, so an empty default never reaches a collector.
model Setting {
  id                            Int      @id @default(1)
  // The terms every collector searches for.
  search_terms                  Json?
  // The location the Austin searches read.
  location                      String?
  // Search radius around that location, in miles.
  radius                        Int?
  // How many days old a posting may be before it counts as expired. The
  // browser collectors stop paginating once they reach it.
  expiry_threshold              Int?
  // The closed list of words that name a job: designer, researcher,
  // engineer, manager. Finding one is what tells the title rule which part
  // of a title is the role.
  title_head_nouns              Json?
  // Each stored seniority spelling with the spellings that match it, held
  // as a list of objects with a store string and a match list. senior, sr,
  // and sr. all store as Sr.
  title_levels                  Json?
  // Word endings that name a person doing a job, like -er, -or, and -ist.
  // Used when no head noun matched, so a profession the list has never
  // seen is still recognized.
  title_suffixes                Json?
  // Words taken out of a title's team part only, never out of the role,
  // because each one can legitimately appear in a real role.
  title_removal_words           Json?
  // One flat ordered list ranking every parser and collector together,
  // each entry prefixed by its kind, so parser:greenhouse and
  // collector:greenhouse are two separate entries. Every field except the
  // dates and collected_at resolves by it. collector:user is seeded at
  // the top, so a job entered by hand wins every contested field. A
  // source absent from the list ranks below every source in it. npm run
  // db:seed appends any missing registry name to the bottom and never
  // reorders or removes.
  source_priority_list          Json?
  // Resolution runs in two lanes, and these three pace them. Every job starts
  // in the fast lane; a host that refuses us sends its remaining jobs to the
  // slow lane, which runs once the fast lane is done and that host has had
  // time to cool off. Nothing here names a host — which hosts end up in the
  // slow lane is decided by what they did during the run.
  //
  // How many jobs the fast lane resolves at a time. A headed browser holds
  // focus for as long as it runs, so the machine is unusable while a run
  // lasts and shortening that is what raising this buys. The four-page limit
  // is not a setting beside it: it stays a constant in code, changed against
  // real numbers rather than turned up in the moment.
  resolution_fast_concurrency   Int?
  // How many jobs the slow lane resolves at a time. Every job there belongs
  // to a host that already refused us once this run, so this is normally one.
  resolution_slow_concurrency   Int?
  // How long the slow lane waits between jobs. Measured against Adzuna on
  // 2026-09-12: around 25 page visits per five minutes passed and about 30
  // was refused, so twelve seconds sits just under the ceiling the strictest
  // host we have met was enforcing.
  resolution_slow_pause_seconds Int?
  // How far apart a posting's two dates must be before the job counts as
  // posted again rather than as one listing two collectors disagree about.
  // Measured in days and compared as an exact duration, so the hours between
  // two collectors seeing the same posting are absorbed rather than counted.
  repost_gap_days               Int?
  created_at                    DateTime @default(now())
  modified_at                   DateTime @updatedAt
}

// One row per event in a job's path through the pipeline. A job enters at
// collection, passes through each step, and either reaches the end or hits a
// dead end recording when and why. This is a record of each job's path, not validation,
// not source-health monitoring, not run reporting. Only a job search writes
// traces.
//
// step names the pipeline stage, in order: backlog_cleanup, collection,
// post_collection_normalization, post_collection_association,
// post_collection_dedupe, post_collection_save, resolution,
// post_resolution_dedupe, post_resolution_save, parsing,
// post_parsing_normalization, post_parsing_association, post_parsing_dedupe,
// post_parsing_save, classification, post_classification_save, scoring.
// Everything from collection through the save after parsing writes today;
// backlog_cleanup, classification, post_classification_save and scoring are
// what each later phase adds once it exists, the way Job.status grows its
// comment.
//
// event names what happened. Collection writes collected and abandoned;
// normalization writes job_updated where a field was normalized and
// normalization_failed where a raw value it could act on produced nothing;
// company association writes company_associated where the job came out with a
// company, company_updated where it filled a company's empty name,
// association_failed where the job came out with none, and
// company_update_failed where the name it went to write was already taken.
// Save writes job_dbrow_created where a row is written for a job not already
// on file, carrying the collection-time id; job_dbrow_updated where an
// existing row takes merged fields; job_dbrow_status_updated where an active
// row takes a different status and nothing else; and job_dbrow_deleted where
// a row that dedupe marked for removal is deleted. It reuses collection's
// abandoned for a write that throws, so the entry never lands; step and
// reason are what tell the two abandoned populations apart. Save also writes
// job_dbrow_delete_refused, where the active guardrail kept a row dedupe had
// marked. Dedupe writes abandoned for every entry it marks away, whether or
// not that entry held a row, and writes added_to_job_list where a stored row
// joined this run's list; that row's job_id and collector both come from the
// stored row, because that row is the job the event describes. Resolution
// writes job_resolved where a job's resolution reached a page the rules accepted and
// resolution_failed where it did not, and reuses abandoned where a collected
// job's resolution reached a blacklisted host. Collection writes job_resolved
// too, for a job a self-resolving collector handed over already pointing at
// the employer's own posting; step and reason tell the two populations apart.
// Parsing writes job_parsed where a parser read the employer's own posting
// and came back with at least one field, and parse_failed where it did not.
// It reuses no earlier step's event, because reading a posting is not
// something any earlier step does.
//
// abandoned ends a job's path through the pipeline and makes no claim
// about whether a row existed. What became of the row is a separate event:
// job_dbrow_deleted where save carried the delete out, or
// job_dbrow_delete_refused where the active guardrail kept it. A job taking a
// disqualifying status is not abandoned, because it keeps its row and can be
// repaired.
//
// reason names why a dead end happened, and for normalization also how
// completely a field came through.
//
// Collection's usability check writes six codes: no_original_url (no link at
// all), original_url_not_a_url (a link that is not a URL; detail carries the
// offending value), no_raw_title (no title), no_company_identity (neither a
// company name nor a company slug), posting_date_unparseable (a posting date
// that is set and does not parse), posting_updated_date_unparseable (an
// updated date that is set and does not parse).
//
// Normalization writes nine, one set per field, chosen by whether every raw
// value that was present got normalized — all of them, some, or none:
// title_normalized and title_not_normalized (a title has one input, so it is
// never partial); salary_normalized, salary_partially_normalized and
// salary_unusable; work_mode_normalized, work_mode_partially_normalized and
// work_mode_unusable; and company_name_normalized, which has no failure
// twin because a cosmetic tidy cannot fail. salary_unusable and
// work_mode_unusable are the two that warn at the end of a run.
//
// Company association writes six. Three sit under company_associated and say
// how the company was reached: matched_by_slug, matched_by_name, and
// company_created where neither lookup found one. company_name_filled sits
// under company_updated, where a company holding no name took the job's.
// no_name_for_lookup sits under association_failed, where the job's slug
// matched nothing and it carried no name to fall back on; it is spelled apart
// from collection's no_company_identity so a query grouping by reason alone
// does not merge two different populations. company_name_clash sits under
// company_update_failed, where another company already holds that name.
// no_name_for_lookup and company_name_clash are the two that warn.
//
// Save writes one reason of its own: db_write_failed, sitting under
// abandoned, where the write throws and the entry never reaches the table. It
// passes dedupe's reason through unchanged onto job_dbrow_deleted,
// job_dbrow_delete_refused and the abandoned it writes for a marked entry
// that never held a row, so the reason names the match rather than the active
// status.
//
// Dedupe writes four. hard_match_in_list and repost_match_in_list sit under
// abandoned, where an entry merged into another entry on the same list; the
// two are told apart by whether the merged job's pooled dates fall less than
// 24 hours apart. matched_db_row sits under abandoned where the entry left
// the list for a stored row having never been saved, and under
// job_dbrow_deleted where it already held a row of its own.
// matched_list_entry sits under added_to_job_list, on the stored row that
// joined the list.
//
// Collection writes one reason under job_resolved: collector_provided, where
// an ATS board or Dribbble hosted the posting and supplied its url, so the job
// never reaches resolution. It is recorded rather than worked out afterwards,
// because jobs saved minus jobs resolved counts two different populations —
// resolution also processes jobs an earlier run collected.
//
// Resolution writes ten. Four sit under job_resolved and name the rule that
// accepted the page: no_apply_links, where the page offered nowhere further
// to go; link_left_site, where resolution left the host and arrived;
// stayed_on_site, where it stayed within the same site, never left, and
// the page was dropped; and page_limit_reached, where the ceiling was reached
// with a same-host link left unfollowed. Five sit only under
// resolution_failed: dead_end, for a login wall, signup wall or paywall;
// page_unavailable, where a page is not there — a 404 for a filled job, or a
// 401 wanting a login we do not have; page_refused, where the source turned
// us away for now, being a 403, a 429 or a server error, which is the one
// status group worth asking again, and the one that sends its host to the
// slow lane; page_load_failed, where the browser could not load a page at
// all; and posting_gone, where a page answered successfully while its own
// address carried an error flag, which is how a board redirects a dead job
// id to its whole listing.
// page_limit_reached sits there too, for a ceiling reached with an off-host
// link left unfollowed — one population split by outcome, which is what lets
// a single query answer how often four pages is the binding constraint. The
// tenth, blacklisted_url, sits under resolution_failed for a hand-entered
// job and under abandoned for a collected one, whose row is marked for
// deletion instead.
//
// page_refused and page_load_failed are the two that leave a job's status
// untouched, so it returns to the next run's queue. Every other failure
// parks the job as unresolvable. Both describe the moment rather than the
// job: a source turning us away and a browser that could not load a page
// both say nothing about whether the posting is any good.
//
// normalization_failed does not mean nothing was written. A title that
// matched no job noun still stores its cleaned fallback, so the event
// records that the rule did not fire rather than that the field was left
// empty.
//
// A normalization event's detail carries from and to, each cut at 200
// characters, so a collector bug putting a description in the wrong field
// cannot bloat this table in the run someone needs to read. A company name's
// from is the only surviving record of the spelling the source published,
// since the cleaned name overwrites it in place.
//
// Parsing writes three, all sitting under parse_failed.
// no_parser_for_domain, where no parser owns the domain the resolved link
// belongs to, or the link yields no owned domain at all; the job takes
// unparseable, because a later run would reach the same verdict.
// parser_errored, where the parser threw or its source refused the request;
// and nothing_parsed, where the parser ran and returned no field at all.
// Those last two keep the job in the backlog, because both describe an
// outage rather than a verdict on the job, and the next run tries again. A
// parse_failed row also carries the owned domain in the domain column and the
// full resolved link in detail, so a failing platform can be counted and any
// one failure chased back to the exact address it happened on.
//
// Each later phase adds its own reasons once it exists.
model Trace {
  // An auto-incrementing integer key, so two events landing in the same
  // millisecond still have a reliable order.
  id         Int      @id @default(autoincrement())
  // The job search during which the event happened.
  run_id     String
  // The job the event describes. A plain column with no relation, so a trace
  // outlives the job it describes.
  job_id     String
  // Where in the pipeline the event happened.
  step       String
  // What happened there.
  event      String
  // Why a dead end happened, where the event was one.
  reason     String?
  // Which collector produced the job.
  collector  String
  // The domain the job's source owns, on the events where a source is what
  // failed. It is a column of its own rather than a field inside detail
  // because detail is JSON holding a different shape per event, and SQLite
  // cannot group a web address out of it — a counted value has to be
  // groupable.
  domain     String?
  // What is specific to this one event. Nothing that gets counted goes here.
  detail     Json?
  created_at DateTime @default(now())
}
