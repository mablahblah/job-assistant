# Copy this file to .env and fill in values

# SQLite database paths, resolved relative to prisma.config.ts at the repo root
DATABASE_URL="file:./dev.db"

# The new pipeline's database. The old pipeline reads DATABASE_URL and this
# branch's Prisma config reads only this one.
PIPELINE_DATABASE_URL="file:./pipeline.db"

# Adzuna API (https://developer.adzuna.com)
ADZUNA_APP_ID=your_app_id_here
ADZUNA_API_KEY=your_api_key_here

# RapidAPI / JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=your_rapidapi_key_here

# Google Places API — used to enrich company address/phone/website for TWC work search log
# Enable "Places API (New)" in Google Cloud Console; $200/month free credit covers this easily
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Apify API — used to enrich company address/phone/website for TWC work search log
# Get token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Geocode.maps.co API — used for geo-based location classification (free tier, 1 req/sec)
# Sign up at: https://geocode.maps.co/
GEOCODE_MAPS_API_KEY=your_geocode_maps_api_key_here
