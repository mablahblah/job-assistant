# Copy this file to .env and fill in values

# The database, resolved relative to prisma.config.ts at the repo root. This is
# the only database url the app reads.
PIPELINE_DATABASE_URL="file:./pipeline.db"

# The old pipeline's database. Nothing in the app reads it — it is named here
# only because scripts/db-migrate-data.ts takes it straight from the
# environment when moving the last of the old data across. Once dev.db is
# deleted, this line goes with it.
DATABASE_URL="file:./dev.db"

# Adzuna API (https://developer.adzuna.com)
ADZUNA_APP_ID=your_app_id_here
ADZUNA_API_KEY=your_api_key_here

# RapidAPI / JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=your_rapidapi_key_here

# Apify API — fills in an employer's address, phone and website for the Texas
# Workforce Commission work search log
# Get token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Apify API, second account — runs the Fantastic.jobs trial, the actor
# fantastic-jobs/career-site-job-listing-api, at $4 per 1,000 jobs returned.
# A separate account, so the trial's spend and the work log's never share
# one free allowance.
# Get token from: https://console.apify.com/account/integrations
FANTASTIC_JOBS_APIFY_TOKEN=your_second_apify_api_token_here

# TheirStack API — runs the TheirStack trial. A new account gets 200 jobs free,
# once; each job returned costs 1 credit after that.
# Get key from: https://app.theirstack.com/settings/api-key (shown only once)
THEIRSTACK_API_KEY=your_theirstack_api_key_here

# Geocode.maps.co API — turns a job's location into coordinates so it can be
# measured against your own (free tier, 1 request per second)
# Sign up at: https://geocode.maps.co/
GEOCODE_MAPS_API_KEY=your_geocode_maps_api_key_here
