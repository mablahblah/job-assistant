# Copy this file to .env.local and fill in values
# WARNING: If this repo ever goes public, scrub git history first — real credentials were committed in earlier commits.

# SQLite database path (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Adzuna API (https://developer.adzuna.com)
ADZUNA_APP_ID=your_app_id_here
ADZUNA_API_KEY=your_api_key_here

# Apify API — used to enrich company address/phone/website for TWC work search log
# Get token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here
